#!/usr/bin/env bash
#
# papercut - log the friction you hit while working, then keep working.
#
# A "papercut" is a small piece of friction: a CLI that lacked a flag, a stale
# README, a shell quoting trap. Coding agents (Claude Code, Codex, Grok, ...)
# append one line per papercut to a shared JSONL log. Later you read the log
# back, group it, and record decisions ("fixed", "wontfix", "ticketed") in a
# separate triage ledger. Neither file is ever rewritten, so many sessions can
# append at once.
#
# Inspired by Steve Ruiz's papercuts tool:
#   https://x.com/steveruizok/status/2075303919664734295
#
# USAGE
#   papercut [--tool NAME] [--category CAT] [--fixable V] [--agent NAME]
#            [--fixed] [--] TEXT...
#   papercut [flags] -              read the text from piped stdin
#   papercut --resolve --status STATUS SELECTORS... [--reason TEXT]
#   papercut --tail [N] | --group | --stats | --annotate [FILTERS...]
#   papercut --count | --triage | --where | --help | --version
#
# EXAMPLES
#   papercut --tool rg 'searching callers -> unquoted glob aborted -> quote it'
#   papercut --category docs --tool gh 'README lists a removed flag -> fix it'
#   papercut --tool 'pnpm test' --fixed 'ran from the wrong cwd -> documented'
#   papercut --tool rg - <<'EOF'
#   text with 'quotes', `backticks` and $vars goes in verbatim
#   EOF
#   papercut --resolve --status fixed --tool rg --reason 'quoted' --ref PR#42
#
# The first argument picks the mode; anything else is write mode. Write mode
# prints nothing on success.
#
# WRITE MODE (flags may appear anywhere among the text words)
#   --tool NAME      what caused the friction; the clustering key
#   --category CAT   tooling (default), env, docs, shell, test, codebase, other
#   --fixable V      yes = you could have fixed it but didn't; no (default) =
#                    not yours to fix; fixed = you fixed it
#   --fixed          same as --fixable fixed
#   --agent NAME     override the detected agent name
#   -                read the text from stdin (not from a terminal); quotes,
#                    backticks and $ are kept as-is
#   --               everything after this is text, even words starting with -
# Words are joined with spaces and newlines become spaces. Text longer than
# 2000 characters is cut there. Each entry has the fields ts, session_id,
# agent, project, cwd, git_branch, category, tool, text and fixable.
#
# READ MODES
#   --tail [N]       last N entries (default 10), human-readable
#   --group          the open papercuts grouped by tool, as one line of JSON:
#                    groups, fixes that didn't hold, wontfix decisions that
#                    keep coming back, resolved counts (the skill reads this)
#   --stats          counts by category, agent, fixable and project, a 14-day
#                    trend, and papercuts per session for each agent
#   --annotate       every entry as JSON, plus a "triage" field saying which
#                    decision covers it
#   --count          total entries, and entries from the current session
#   --triage         recorded decisions, with how many entries each covers and
#                    how many arrived after it
#   --where          the log and ledger paths in use
# Lines that aren't valid JSON are skipped, so one damaged line never hides
# the rest.
#
# FILTERS (for --tail, --group, --stats and --annotate)
#   --since T        newer than Nd or Nh ago, or a YYYY-MM-DD date (UTC)
#   --agent A, --category C, --tool T, --fixable V    exact matches
#   --project S      project or cwd contains S
#   --top N          --group: only the N biggest groups (default: all)
#   --limit N        --group: texts shown per group (default 30)
# --stats counts sessions over the --since window in days (default 30).
#
# RESOLVE MODE (record a decision about a cluster of papercuts)
#   --status S       fixed, wontfix or ticketed (required)
#   --tool NAME      select entries whose tool is exactly NAME
#   --match RE       select entries whose text matches RE (case-insensitive,
#                    jq regex)
#   --fixable V      select entries by their fixable value
#   --reason TEXT    why; required for fixed and wontfix
#   --ref TEXT       a pointer such as PR#42 or an issue number
#   --dry-run        show what would be recorded; write nothing
# Give at least one selector; all the selectors given must match. A decision
# that matches no entry is refused. A decision covers the entries logged up to
# its time. An entry logged after the latest decision covering it is flagged:
# after "fixed" it's a regression; after "wontfix", --triage flags 5 or more.
#
# FILES AND ENVIRONMENT
#   PAPERCUT_LOG     the log (default: papercuts.jsonl in the state dir)
#   PAPERCUT_TRIAGE  the ledger (default: triage.jsonl in the state dir)
#   PAPERCUT_AGENT   agent name to record instead of the detected one
# The state dir is ${XDG_STATE_HOME:-~/.local/state}/papercut.
#
# Agent detection: CODEX_THREAD_ID or CODEX_SESSION_ID means Codex (session id
# from the same variable); CLAUDECODE or CLAUDE_CODE_SESSION_ID means Claude
# Code (session id from CLAUDE_CODE_SESSION_ID). Grok sets no known marker, so
# Grok passes --agent grok. --agent beats PAPERCUT_AGENT, which beats
# detection.
#
# EXIT CODES
#   0 success   1 couldn't read or write a file   2 usage error   3 no jq
#
# DEPENDENCIES
#   bash 3.2+ and jq; git is optional (records the branch). macOS and Linux.

VERSION="0.2.0"
MAX_TEXT=2000

set -u
set -o pipefail

if ! command -v jq >/dev/null 2>&1; then
  echo "papercut: jq is required but not found in PATH" >&2
  exit 3
fi

usage() { awk 'NR >= 3 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }
die() { printf 'papercut: %s\n' "$*" >&2; exit 2; }
die_flag() { # flag [context]
  printf "papercut: unknown flag '%s'%s\nRun 'papercut --help' for usage.\n" "$1" "${2:+ for $2}" >&2
  exit 2
}
no_args() { [ $# -eq 0 ] || die "unexpected argument '$1'"; }
now() { date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z | sed 's/\([0-9][0-9]\)$/:\1/'; }
valid_fixable() { case "$1" in yes | no | fixed) return 0 ;; *) return 1 ;; esac; }

# Agent and session detection. Codex is checked first: a Codex run launched from
# inside Claude Code inherits Claude's variables, and the innermost agent logs.
AGENT="unknown"
SESSION="unknown"
if [ -n "${CODEX_THREAD_ID:-}${CODEX_SESSION_ID:-}" ]; then
  AGENT="codex"
  SESSION="${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-}}"
elif [ -n "${CLAUDECODE:-}${CLAUDE_CODE_SESSION_ID:-}" ]; then
  AGENT="claude"
  SESSION="${CLAUDE_CODE_SESSION_ID:-unknown}"
fi
[ -n "${PAPERCUT_AGENT:-}" ] && AGENT="$PAPERCUT_AGENT"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/papercut"
LOG="${PAPERCUT_LOG:-$STATE_DIR/papercuts.jsonl}"
TRIAGE="${PAPERCUT_TRIAGE:-$STATE_DIR/triage.jsonl}"

# Shared jq library for resolve, triage and annotate.
# epoch: ISO-8601 -> unix seconds, minus the UTC offset, so orderings compare
# instants (10:00-08:00 is 18:00Z), not strings.
# safe: strip control characters before printing text a terminal will render.
# hit($d): does decision $d cover the entry? Every non-empty selector must pass.
# shellcheck disable=SC2016  # jq program text: $vars are jq's, not the shell's
JQ_LIB='
def epoch:
  (. // "" | tostring) as $s
  | (try (($s[0:19] + "Z") | fromdateiso8601) catch null) as $t
  | if $t == null then 0 else
      $s[19:] as $z
      | $t - (if $z == "" or $z == "Z" then 0
              else (try (($z[1:3] | tonumber) * 3600 + ($z[4:6] | tonumber) * 60) catch 0)
                   * (if $z[0:1] == "-" then -1 else 1 end)
              end)
    end;
def safe: if type == "string" then gsub("[[:cntrl:]]"; "") else . end;
def hit($d):
  ($d.tool // "") as $t | ($d.match // "") as $m | ($d.fixable // "") as $f
  | ($t != "" or $m != "" or $f != "")
    and ($t == "" or (.tool // "") == $t)
    and ($f == "" or (.fixable // "") == $f)
    and ($m == "" or (try ((.text // "") | test($m; "i")) catch false));
# keep($f): does the entry pass the read filters in $f (see parse_filters)?
def keep($f):
  ($f.since == null or (.ts | epoch) >= $f.since)
  and ($f.agent == null or .agent == $f.agent)
  and ($f.category == null or .category == $f.category)
  and ($f.tool == null or (.tool // "") == $f.tool)
  and ($f.fixable == null or .fixable == $f.fixable)
  and ($f.project == null or (((.project // "") + "\n" + (.cwd // "")) | contains($f.project)));
'

# valid FILE: the file's JSON lines, skipping any that don't parse.
valid() { [ -f "$1" ] || return 0; jq -c -R 'fromjson? // empty' "$1"; }

# append FILE LINE: add one line. bash's printf may split a long line into
# several writes, which concurrent appenders can interleave; cat copies the
# small temp file in a single write.
append() {
  local file="$1" tmp
  mkdir -p "$(dirname "$file")" 2>/dev/null
  tmp=$(mktemp "${TMPDIR:-/tmp}/papercut.XXXXXX") || { echo "papercut: can't create a temp file" >&2; exit 1; }
  if printf '%s\n' "$2" > "$tmp" && cat "$tmp" >> "$file"; then
    rm -f "$tmp"
  else
    rm -f "$tmp"
    echo "papercut: couldn't write to $file" >&2
    exit 1
  fi
}

# --- Read filters, shared by --tail, --annotate, --group and --stats ---------
FILTER='{}'      # JSON object for keep($f); {} keeps everything
LIMIT=30         # --group: entries shown per group
TOP=0            # --group: groups shown (0 = all)
WINDOW_DAYS=30   # --stats: the per-session rate window

parse_filters() {
  local since="" agent="" category="" tool="" fixable="" project="" from
  while [ $# -gt 0 ]; do
    case "$1" in
      --since | --agent | --category | --tool | --fixable | --project | --limit | --top)
        [ $# -ge 2 ] || die "$1 requires a value"
        case "$1" in
          --since) since="$2" ;;
          --agent) agent="$2" ;;
          --category) category="$2" ;;
          --tool) tool="$2" ;;
          --fixable) fixable="$2" ;;
          --project) project="$2" ;;
          --limit) LIMIT="$2" ;;
          --top) TOP="$2" ;;
        esac
        shift 2 ;;
      -*) die_flag "$1" "$MODE_NAME" ;;
      *) die "unexpected argument '$1'" ;;
    esac
  done
  case "$LIMIT" in '' | *[!0-9]*) die "--limit takes a number, got '$LIMIT'" ;; esac
  case "$TOP" in '' | *[!0-9]*) die "--top takes a number, got '$TOP'" ;; esac
  case "$category" in
    "" | tooling | env | docs | shell | test | codebase | other) ;;
    *) die "invalid --category '$category' (valid: tooling env docs shell test codebase other)" ;;
  esac
  if [ -n "$fixable" ] && ! valid_fixable "$fixable"; then
    die "invalid --fixable '$fixable' (valid: yes no fixed)"
  fi

  from="null"
  if [ -n "$since" ]; then
    local now n
    now=$(date +%s)
    if [[ "$since" =~ ^([0-9]+)d$ ]]; then
      n="${BASH_REMATCH[1]}"; from=$((now - n * 86400)); WINDOW_DAYS="$n"
    elif [[ "$since" =~ ^([0-9]+)h$ ]]; then
      n="${BASH_REMATCH[1]}"; from=$((now - n * 3600)); WINDOW_DAYS=$(((n + 23) / 24))
    elif [[ "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      # Round-trip the date, since fromdateiso8601 quietly rolls 02-30 into March.
      from=$(jq -ne --arg d "$since" '($d + "T00:00:00Z") | fromdateiso8601
        | if (todate[0:10]) == $d then . else error end' 2>/dev/null) \
        || die "invalid --since date '$since'"
      WINDOW_DAYS=$(((now - from + 86399) / 86400))
    else
      die "--since takes Nd, Nh or YYYY-MM-DD, got '$since'"
    fi
  fi

  FILTER=$(jq -nc --argjson since "$from" --arg agent "$agent" --arg category "$category" \
    --arg tool "$tool" --arg fixable "$fixable" --arg project "$project" \
    'def nul: if . == "" then null else . end;
     {since: $since, agent: ($agent | nul), category: ($category | nul), tool: ($tool | nul),
      fixable: ($fixable | nul), project: ($project | nul)}') || exit 1
}

do_write() {
  local tool="" category="tooling" fixable="no" agent="$AGENT" text="" n=0 piece

  add_text() { if [ "$n" -gt 0 ]; then text="$text $1"; else text="$1"; fi; n=$((n + 1)); }

  while [ $# -gt 0 ]; do
    case "$1" in
      --tool | --category | --fixable | --agent)
        [ $# -ge 2 ] || die "$1 requires a value"
        case "$1" in
          --tool) tool="$2" ;;
          --category) category="$2" ;;
          --fixable) fixable="$2" ;;
          --agent) agent="$2" ;;
        esac
        shift 2 ;;
      --fixed) fixable="fixed"; shift ;;
      -)
        if [ -t 0 ]; then
          die "'-' reads the text from piped stdin (e.g. a <<'EOF' heredoc)"
        fi
        piece=$(cat)
        add_text "$piece"
        shift ;;
      --)
        shift
        for piece in "$@"; do add_text "$piece"; done
        break ;;
      -*) die_flag "$1" ;;
      *) add_text "$1"; shift ;;
    esac
  done

  if [ -z "${text//[[:space:]]/}" ]; then
    printf "papercut: no complaint text given\nRun 'papercut --help' for usage.\n" >&2
    exit 2
  fi
  case "$category" in
    tooling | env | docs | shell | test | codebase | other) ;;
    *) printf "papercut: invalid --category '%s'\n  valid: tooling env docs shell test codebase other\n" "$category" >&2; exit 2 ;;
  esac
  valid_fixable "$fixable" || die "invalid --fixable '$fixable' (valid: yes no fixed)"

  local project branch line
  project=$(printf '%s' "$PWD" | tr -c 'a-zA-Z0-9' '-')
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""

  # jq builds the JSON, so quotes, backticks and newlines can't corrupt the log.
  line=$(jq -nc --arg ts "$(now)" --arg sid "$SESSION" --arg agent "$agent" \
    --arg project "$project" --arg cwd "$PWD" --arg branch "$branch" \
    --arg category "$category" --arg tool "$tool" --arg text "$text" --arg fixable "$fixable" \
    --argjson max "$MAX_TEXT" \
    '{ts: $ts, session_id: $sid, agent: $agent, project: $project, cwd: $cwd,
      git_branch: $branch, category: $category, tool: $tool,
      text: ($text | gsub("[\\r\\n]+"; " ") | .[0:$max]), fixable: $fixable}') || exit 1
  append "$LOG" "$line"
}

do_resolve() {
  local dstatus="" tool="" match="" fixable="" reason="" ref="" fixable_given=0 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --status | --tool | --match | --fixable | --reason | --ref)
        [ $# -ge 2 ] || die "$1 requires a value"
        case "$1" in
          --status) dstatus="$2" ;;
          --tool) tool="$2" ;;
          --match) match="$2" ;;
          --fixable) fixable="$2"; fixable_given=1 ;;
          --reason) reason="$2" ;;
          --ref) ref="$2" ;;
        esac
        shift 2 ;;
      --dry-run) dry=1; shift ;;
      -*) die_flag "$1" "--resolve" ;;
      *) die "unexpected argument '$1' for --resolve (did you forget --reason?)" ;;
    esac
  done

  [ -n "$dstatus" ] || die "--resolve requires --status (valid: fixed wontfix ticketed)"
  case "$dstatus" in
    fixed | wontfix | ticketed) ;;
    *) die "invalid --status '$dstatus' (valid: fixed wontfix ticketed)" ;;
  esac
  # An explicitly empty --fixable is invalid, not "no selector".
  if [ "$fixable_given" -eq 1 ] && ! valid_fixable "$fixable"; then
    die "invalid --fixable '$fixable' (valid: yes no fixed)"
  fi
  if [ -z "$tool" ] && [ -z "$match" ] && [ -z "$fixable" ]; then
    die "--resolve needs a selector: --tool <exact tool>, --match <regex> and/or --fixable <yes|no|fixed>"
  fi
  if [ "$dstatus" != "ticketed" ] && [ -z "${reason//[[:space:]]/}" ]; then
    die "--reason is required for --status $dstatus"
  fi
  if [ -n "$match" ]; then
    jq -n --arg m "$match" '"" | test($m; "i")' >/dev/null 2>&1 \
      || die "--match '$match' is not a valid regex (jq/Oniguruma syntax)"
  fi

  local dec stats n latest
  dec=$(jq -nc --arg ts "$(now)" --arg tool "$tool" --arg match "$match" --arg st "$dstatus" \
    --arg reason "$reason" --arg ref "$ref" --arg fixable "$fixable" --argjson hasf "$fixable_given" \
    'def nul: if . == "" then null else . end;
     {ts: $ts, tool: ($tool | nul), match: ($match | nul), status: $st,
      reason: ($reason | gsub("[\\r\\n]+"; " ") | nul), ref: ($ref | nul)}
     | if $hasf == 1 then .fixable = $fixable else . end') || exit 1

  stats=$(valid "$LOG" | jq -sr --argjson d "$dec" "$JQ_LIB"'
    [.[] | select(hit($d))] as $h
    | "\($h | length)\t\(($h | map(.ts // "") | max_by(epoch)) // "-")"') || exit 1
  n="${stats%%$'\t'*}"
  latest="${stats#*$'\t'}"
  printf "papercut: selector [tool=%s match=%s fixable=%s] matches %s log entries (latest: %s)\n" \
    "${tool:--}" "${match:--}" "${fixable:--}" "$n" "$latest" >&2

  if [ "$n" -eq 0 ]; then
    echo "papercut: selector matches nothing — refusing to record a dead decision." >&2
    if [ -n "$tool" ]; then
      local k near
      k=$(valid "$LOG" | jq -s --arg t "$tool" '[.[] | select((.tool // "") == $t)] | length')
      if [ "${k:-0}" -gt 0 ]; then
        echo "  tool '$tool' has $k entries, but the other selectors exclude all of them." >&2
      else
        near=$(valid "$LOG" | jq -sr --arg t "$tool" "$JQ_LIB"'
          [.[] | (.tool // "") | select(. != "" and (ascii_downcase | contains($t | ascii_downcase)))]
          | group_by(.) | map({t: .[0], n: length}) | sort_by(-.n) | .[:8][]
          | "    \(.n) \(.t | safe)"')
        if [ -n "$near" ]; then
          echo "  tool values containing '$tool':" >&2
          printf '%s\n' "$near" >&2
        fi
      fi
    fi
    echo "  list all tools: papercut --annotate | jq -r .tool | sort | uniq -c | sort -rn" >&2
    exit 2
  fi

  if [ "$dry" -eq 1 ]; then
    echo "papercut: --dry-run, not written: $dec" >&2
    exit 0
  fi
  append "$TRIAGE" "$dec"
  echo "papercut: recorded $dstatus decision in $TRIAGE" >&2
}

do_count() {
  local counts lines ok mine
  counts=$( { if [ -f "$LOG" ]; then cat "$LOG"; fi; } | jq -nrR --arg s "$SESSION" '
    reduce (inputs | select(length > 0)) as $line ({lines: 0, ok: 0, mine: 0};
      .lines += 1
      | ([$line | fromjson? // empty] | first) as $e
      | if $e == null then .
        else .ok += 1 | if $s != "unknown" and $e.session_id == $s then .mine += 1 else . end end)
    | "\(.lines) \(.ok) \(.mine)"') || exit 1
  read -r lines ok mine <<<"$counts"
  printf 'total: %s\nthis session: %s\n' "$ok" "$mine"
  if [ "$lines" -gt "$ok" ]; then
    echo "skipped: $((lines - ok)) lines that aren't valid JSON"
  fi
}

do_tail() {
  local n="$1"
  if [ ! -f "$LOG" ]; then echo "no papercuts logged yet"; return 0; fi
  # Without filters only the end of the file is read; with them, all of it.
  if [ "$FILTER" = '{}' ]; then tail -n "$n" "$LOG"; else valid "$LOG" | jq -c --argjson f "$FILTER" "$JQ_LIB"'select(keep($f))' | tail -n "$n"; fi \
  | jq -r -R "$JQ_LIB"'
    fromjson? // empty
    | map_values(safe)
    | "\(.ts)  \(.agent // "?")  [\(.category // "?")\(if (.tool // "") != "" then "/" + .tool else "" end)]  fixable=\(.fixable // "?")\n  \(.text)\n"'
}

do_triage() {
  if [ ! -s "$TRIAGE" ]; then
    echo "no triage decisions yet ($TRIAGE)"
    return 0
  fi
  valid "$TRIAGE" | jq -nr --slurpfile log <(valid "$LOG") "$JQ_LIB"'
    def dash: if . == null or . == "" then "-" else . end;
    def pad8: if length < 8 then (. + "        ")[0:8] else . end;
    # Entries are prepared once and indexed by tool; a decision naming a tool
    # only looks at that tool'"'"'s entries.
    [$log[] | . + {_et: (.ts | epoch)}] as $L
    | ($L | group_by(.tool // "") | map({key: (.[0].tool // ""), value: .}) | from_entries) as $by_tool
    | inputs
    | . as $d
    | [(if ($d.tool // "") != "" then ($by_tool[$d.tool] // []) else $L end)[] | select(hit($d))] as $h
    | ($d.ts | epoch) as $dt
    | ($h | length) as $n
    | ([$h[] | select(._et > $dt)] | length) as $m
    | (if $d.status == "fixed" and $m > 0 then "  <-- FIXED BUT STILL BITING"
       elif $d.status == "wontfix" and $m >= 5 then "  <-- wontfix re-surfacing (>=5 since)"
       else "" end) as $flag
    | ($d | map_values(safe)) as $d
    | "\($d.ts)  \(($d.status // "") | pad8)  tool=\($d.tool | dash)  match=\($d.match | dash)"
      + (if ($d.fixable // "") != "" then "  fixable=\($d.fixable)" else "" end)
      + "\n  matches: \($n)  (after decision: \($m))\($flag)"
      + "\n  reason: \($d.reason | dash)\n  ref: \($d.ref | dash)\n"'
}

# Each entry gets the latest covering decision at or after it ("resolved"); if
# there is none, the latest one before it decides the state.
do_annotate() {
  [ -s "$LOG" ] || return 0
  valid "$LOG" | jq -nc --argjson f "$FILTER" --slurpfile dec <(valid "$TRIAGE") "$JQ_LIB"'
    # Ties on time go to the later ledger line (_i), as a plain scan would.
    def latest($c): if ($c | length) == 0 then null else ($c | max_by([._dt, ._i])) end;
    def state: {fixed: "regressed", ticketed: "after_ticketed", wontfix: "after_wontfix"}[.status];
    def tag($d; $s):
      if $d == null then null
      else {state: $s, status: $d.status, decision_ts: $d.ts, tool: $d.tool, match: $d.match,
            fixable: $d.fixable, reason: $d.reason, ref: $d.ref} end;
    # Decisions are prepared once and indexed by tool, so each entry is only
    # checked against its own tool'"'"'s decisions plus the few without a tool.
    [$dec | to_entries[] | .value + {_dt: (.value.ts | epoch), _i: .key}] as $D
    | ($D | map(select((.tool // "") != "")) | group_by(.tool)
       | map({key: .[0].tool, value: .}) | from_entries) as $by_tool
    | [$D[] | select((.tool // "") == "")] as $no_tool
    | inputs
    | select(keep($f))
    | . as $e
    | ($e.ts | epoch) as $et
    | [(($by_tool[$e.tool // ""] // []) + $no_tool)[] | select(. as $d | $e | hit($d))] as $cov
    | latest([$cov[] | select(._dt >= $et)]) as $after
    | latest([$cov[] | select(._dt < $et)]) as $before
    | $e + {triage: (
        if $after then tag($after; "resolved")
        elif $before then tag($before; $before | state)
        else null end)}'
}

# --group: everything the papercuts skill needs, as one JSON object. Active
# entries (untriaged or after a ticketed decision) are grouped by tool; fixes
# that didn't hold and wontfix decisions that keep coming back are separate.
do_group() {
  do_annotate | jq -sc --argjson limit "$LIMIT" --argjson top "$TOP" "$JQ_LIB"'
    def counts(f): group_by(f) | map({key: (.[0] | f | tostring), value: length}) | from_entries;
    def newest_first: sort_by(.ts | epoch) | reverse;
    def show: newest_first | .[:$limit] | map({ts, agent, category, fixable, project, text});
    def omitted: if length > $limit then length - $limit else 0 end;
    def by_decision: group_by([.triage.decision_ts, .triage.tool, .triage.match, .triage.fixable]);
    map(map_values(safe) | .triage |= (if . then map_values(safe) else . end)) as $all
    | [$all[] | select(.triage == null or .triage.state == "after_ticketed")] as $active
    | ($active | group_by(.tool // "") | length) as $group_count
    | {
        entries: ($all | length),
        group_count: $group_count,
        states: ($all | counts(.triage.state // "untriaged")),
        groups: ($active | group_by(.tool // "") | map({
            tool: (.[0].tool // ""),
            count: length,
            first: (newest_first | last | .ts),
            last: (newest_first | first | .ts),
            categories: counts(.category // ""),
            agents: counts(.agent // "unknown"),
            fixable: counts(.fixable // ""),
            projects: (map(.project // "") | unique),
            tickets: ([.[] | select(.triage.state == "after_ticketed") | .triage.ref // "-"] | unique),
            entries: show,
            omitted: omitted
          }) | sort_by([-.count, -(.last | epoch)]) | if $top > 0 then .[:$top] else . end),
        regressions: ([$all[] | select(.triage.state == "regressed")] | by_decision | map({
            tool: .[0].triage.tool, match: .[0].triage.match, fixable: .[0].triage.fixable,
            fixed_at: .[0].triage.decision_ts, reason: .[0].triage.reason, ref: .[0].triage.ref,
            count: length, last: (newest_first | first | .ts), entries: show, omitted: omitted
          }) | sort_by(-.count)),
        wontfix_resurfacing: ([$all[] | select(.triage.state == "after_wontfix")] | by_decision
          | map(select(length >= 5) | {
            tool: .[0].triage.tool, match: .[0].triage.match, decided_at: .[0].triage.decision_ts,
            reason: .[0].triage.reason, count: length, entries: show, omitted: omitted
          }) | sort_by(-.count)),
        already_fixed: ([$active[] | select(.triage == null and .fixable == "fixed")]
          | {count: length, tools: counts(.tool // "")}),
        resolved: ([$all[] | select(.triage.state == "resolved")]
          | {entries: length, decisions: (by_decision | length)})
      }'
}

# --stats: counts and trends for a person to read, plus how often each agent
# logs per session (a rate near zero means its instructions aren't reaching it).
do_stats() {
  local claude codex grok
  claude=$(find "$HOME/.claude/projects" -mindepth 2 -maxdepth 2 -name '*.jsonl' -mtime "-$WINDOW_DAYS" 2>/dev/null | wc -l)
  codex=$(find "$HOME/.codex/sessions" -name 'rollout-*.jsonl' -mtime "-$WINDOW_DAYS" 2>/dev/null | wc -l)
  grok=$(find "$HOME/.grok/sessions" -mindepth 2 -maxdepth 2 -type d -mtime "-$WINDOW_DAYS" 2>/dev/null | wc -l)
  valid "$LOG" | jq -rs --argjson f "$FILTER" --argjson days "$WINDOW_DAYS" \
    --argjson sessions "{\"claude\": $claude, \"codex\": $codex, \"grok\": $grok}" "$JQ_LIB"'
    def pad($n): tostring | . + (" " * ([$n - length, 0] | max));
    def two: (. * 100 | round) as $c
      | "\($c / 100 | floor).\($c % 100 | tostring | if length < 2 then "0" + . else . end)";
    def table($xs): $xs | map("  \(.key | pad(12)) \(.value)") | join("\n");
    def counts(f): group_by(f) | map({key: (.[0] | f | tostring | safe), value: length}) | sort_by(-.value);
    (now - $days * 86400) as $from
    | . as $everything
    | [.[] | select(keep($f))] as $all
    | [range(13; -1; -1) | (now - . * 86400) | strflocaltime("%Y-%m-%d")] as $daylist
    | ($all | map(.ts[0:10]) | group_by(.) | map({key: .[0], value: length}) | from_entries) as $per_day
    | [$everything[] | select((.ts | epoch) >= $from)] as $recent
    | "entries: \($all | length)",
      "by category:", table($all | counts(.category // "")),
      "by agent:", table($all | counts(.agent // "unknown")),
      "by fixable:", table($all | counts(.fixable // "")),
      "top projects:", table($all | counts(.project // "") | .[:10]),
      "last 14 days:", ($daylist | map("  \(.)  \($per_day[.] // 0)") | join("\n")),
      "papercuts per session, last \($days) days:",
      (["claude", "codex", "grok"] | map(. as $a
        | ([$recent[] | select(.agent == $a)] | length) as $n
        | $sessions[$a] as $s
        | "  \($a | pad(8)) \($n) / \($s) sessions = "
          + (if $s > 0 then ($n / $s | two) else "-" end))
        | join("\n")),
      "  (\([$recent[] | select((.agent // "unknown") == "unknown")] | length) more with no agent)"'
}

MODE_NAME="${1:-}"
case "${1:-}" in
  --resolve) shift; do_resolve "$@" ;;
  --triage) shift; no_args "$@"; do_triage ;;
  --annotate) shift; parse_filters "$@"; do_annotate ;;
  --group) shift; parse_filters "$@"; do_group ;;
  --stats) shift; parse_filters "$@"; do_stats ;;
  --help | -h) shift; no_args "$@"; usage ;;
  --version) shift; no_args "$@"; echo "papercut $VERSION" ;;
  --count) shift; no_args "$@"; do_count ;;
  --where) shift; no_args "$@"; printf 'log: %s\nledger: %s\n' "$LOG" "$TRIAGE" ;;
  --tail)
    shift
    n=10
    case "${1:-}" in "" | -*) ;; *[!0-9]*) die "--tail takes a number, got '$1'" ;; *) n="$1"; shift ;; esac
    parse_filters "$@"
    do_tail "$n" ;;
  *) do_write "$@" ;;
esac
